{
  "name": "@yfm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor de emparejamiento y salas privadas para el duelo en linea.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-force-exit \"dist-test/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@yfm/engine": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}